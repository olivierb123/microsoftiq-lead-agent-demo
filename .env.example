# Deployed Foundry IQ docs agent endpoint (Responses protocol).
# Server-side only (no VITE_ prefix) — read by vite.config.js's dev-server
# proxy, never bundled into client-side JS. Requires `az login` locally so
# DefaultAzureCredential can mint a token for https://ai.azure.com/.default.
FOUNDRY_IQ_AGENT_URL=https://cog-wkedqxabla6qo.services.ai.azure.com/api/projects/agent-dev/agents/foundryiq-docs-agent/endpoint/protocols/openai/responses?api-version=v1

# Deployed Fabric IQ sales agent endpoint (Responses protocol). Same auth as above.
FABRIC_IQ_AGENT_URL=https://cog-wkedqxabla6qo.services.ai.azure.com/api/projects/agent-dev/agents/fabriciq-sales-agent/endpoint/protocols/openai/responses?api-version=v1
