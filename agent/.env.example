# Foundry project connection (this project's own Foundry project — separate from lead-agent-demo's)
# Copy this file to .env and fill in real values. .env is gitignored.

FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search — Foundry IQ grounding source for the Product Docs domain
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=product-docs
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=product-docs-semantic-config

# Fabric — Fabric IQ grounding source for the Sales Performance domain
# Workspace ID and dataset (semantic model) ID, copied from the Fabric portal URL
# for the Lakehouse's auto-generated default semantic model.
AZURE_POWERBI_WORKSPACE_ID=<your-fabric-workspace-id>
AZURE_POWERBI_DATASET_ID=<your-semantic-model-dataset-id>

# Dedicated classic Entra app registration for Power BI REST API calls.
# Power BI does not recognize Foundry's auto-provisioned per-agent "Agent
# Identity" as an authorizable principal, so a standard service principal
# (with its own client secret) is required. Grant it Contributor on the
# workspace (using its Entra *object ID*, not its app/client ID, for
# principalType=App calls) and Build permission on the dataset.
AZURE_POWERBI_SP_TENANT_ID=<your-tenant-id>
AZURE_POWERBI_SP_CLIENT_ID=<your-service-principal-client-id>
AZURE_POWERBI_SP_CLIENT_SECRET=<your-service-principal-client-secret>

